# Copy this file to ".env" and fill in your secrets. ".env" is gitignored.
# The app loads .env automatically on startup (set once, never re-type).

# Optional: Tavily AI web-search fallback (free key at https://tavily.com).
# Used only when the job boards return fewer results than requested.
TAVILY_API_KEY=

# Optional: Google service account JSON (single line) for the Sheet cron / Vercel.
# GOOGLE_CREDENTIALS=

# PIN that unlocks "My Profile" mode (also add it as an env var on Vercel).
PROFILE_PIN=

# Cross-device "opened" tag (phone/tablet/PC share which jobs you already opened).
# Vercel dashboard -> Storage -> Create -> Upstash Redis (free) -> connect to this project: it adds
# these two automatically (nothing to type). Without them the tag stays per-browser.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
